<!DOCTYPE html>
<html lang="pl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MediBook</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/MediBook.styles.css"
          asp-append-version="true" />

</head>

<body>

<header>

    <nav class="navbar navbar-expand-lg medibook-navbar">

        <div class="container">

            <a class="navbar-brand medibook-logo"
               asp-controller="Home"
               asp-action="Index">

                MediBook

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMain"
                    aria-controls="navbarMain"
                    aria-expanded="false"
                    aria-label="Przełącz nawigację">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarMain">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Strona główna

                        </a>

                    </li>

                    @if (User.IsInRole("Administrator"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PanelAdministratora"
                               asp-action="Index">

                                Panel

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Specjalizacje"
                               asp-action="Index">

                                Specjalizacje

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PlacowkiMedyczne"
                               asp-action="Index">

                                Placówki

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Lekarze"
                               asp-action="Index">

                                Lekarze

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Pacjenci"
                               asp-action="Index">

                                Pacjenci

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="GrafikiLekarzy"
                               asp-action="Index">

                                Grafik

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Wizyty"
                               asp-action="Index">

                                Wizyty

                            </a>

                        </li>
                    }

                    @if (User.IsInRole("Pacjent"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="MojeWizyty"
                               asp-action="Index">

                                Moje wizyty

                            </a>

                        </li>
                    }

                    @if (User.IsInRole("Lekarz"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PanelLekarza"
                               asp-action="Index">

                                Moje wizyty

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PanelLekarza"
                               asp-action="Grafik">

                                Mój grafik

                            </a>

                        </li>
                    }

                </ul>

                <ul class="navbar-nav align-items-lg-center">

                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">

                            <span class="nav-link medibook-user">

                                @User.Identity.Name

                            </span>

                        </li>

                        <li class="nav-item">

                            <form asp-controller="Konto"
                                  asp-action="Wyloguj"
                                  method="post">

                                <button type="submit"
                                        class="btn medibook-logout">

                                    Wyloguj

                                </button>

                            </form>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-lg-2">

                            <a class="nav-link"
                               asp-controller="Konto"
                               asp-action="Logowanie">

                                Zaloguj

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="btn medibook-register"
                               asp-controller="Konto"
                               asp-action="Rejestracja">

                                Rejestracja

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

</header>

<main class="main-content">

    <div class="container">

        @if (TempData["Blad"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                @TempData["Blad"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Zamknij">
                </button>

            </div>
        }

        @if (TempData["Sukces"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                @TempData["Sukces"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Zamknij">
                </button>

            </div>
        }

        @RenderBody()

    </div>

</main>

<footer class="medibook-footer">

    <div class="container">

        <span>
            © 2026 MediBook
        </span>

        <span>
            System umawiania wizyt medycznych
        </span>

    </div>

</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true">
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>
