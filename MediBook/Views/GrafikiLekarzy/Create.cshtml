@model MediBook.Models.GrafikLekarza

@{
    ViewData["Title"] = "Dodaj grafik";
}

<h1>Dodaj grafik lekarza</h1>

<form asp-action="Create"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">

        <label asp-for="LekarzId"
               class="form-label">
            Lekarz
        </label>

        <select asp-for="LekarzId"
                asp-items="ViewBag.Lekarze"
                class="form-select">

            <option value="">
                Wybierz lekarza
            </option>

        </select>

        <span asp-validation-for="LekarzId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Data"
               class="form-label">
            Data
        </label>

        <input asp-for="Data"
               type="date"
               class="form-control"
               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

        <span asp-validation-for="Data"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="GodzinaOd"
               class="form-label">
            Godzina od
        </label>

        <input asp-for="GodzinaOd"
               type="time"
               step="1800"
               class="form-control" />

        <span asp-validation-for="GodzinaOd"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="GodzinaDo"
               class="form-label">
            Godzina do
        </label>

        <input asp-for="GodzinaDo"
               type="time"
               step="1800"
               class="form-control" />

        <span asp-validation-for="GodzinaDo"
              class="text-danger">
        </span>

    </div>

    <div class="form-check mb-3">

        <input asp-for="CzyDostepny"
               class="form-check-input" />

        <label asp-for="CzyDostepny"
               class="form-check-label">
            Dostępny
        </label>

    </div>

    <button type="submit"
            class="btn btn-primary">

        Zapisz

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Wróć

    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}