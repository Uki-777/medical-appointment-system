@model IEnumerable<MediBook.Models.Specjalizacja>

@{
    ViewData["Title"] = "Specjalizacje";
}

<h1>Specjalizacje</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj specjalizację</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nazwa</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nazwa</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>