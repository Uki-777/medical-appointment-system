@model IEnumerable<MediBook.Models.Pacjent>

@{
    ViewData["Title"] = "Pacjenci";
}

<h1>Pacjenci</h1>

<p class="text-muted mb-4">
    Konta pacjentów są tworzone podczas rejestracji użytkowników.
</p>

<div class="table-responsive">

    <table class="table align-middle">

        <thead>

            <tr>

                <th>
                    Imię
                </th>

                <th>
                    Nazwisko
                </th>

                <th>
                    Email
                </th>

                <th>
                    Telefon
                </th>

                <th>
                    Data urodzenia
                </th>

                <th>
                    Akcje
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var pacjent in Model)
            {
                <tr>

                    <td>
                        @pacjent.Imie
                    </td>

                    <td>
                        @pacjent.Nazwisko
                    </td>

                    <td>
                        @pacjent.Email
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(
                            pacjent.NumerTelefonu)
                            ? "-"
                            : pacjent.NumerTelefonu)
                    </td>

                    <td>
                        @(pacjent.DataUrodzenia.HasValue
                            ? pacjent.DataUrodzenia.Value
                                .ToString("dd.MM.yyyy")
                            : "-")
                    </td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@pacjent.Id"
                           class="btn btn-warning btn-sm">

                            Edytuj

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@pacjent.Id"
                           class="btn btn-danger btn-sm">

                            Usuń

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>